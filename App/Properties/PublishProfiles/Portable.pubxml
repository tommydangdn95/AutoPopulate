<?xml version="1.0" encoding="utf-8"?>
<!--
  Bản chạy liền (portable) cho Windows 64-bit, không cần cài .NET:
    dotnet publish App\App.csproj -p:PublishProfile=Portable
  Kết quả: publish\AutoPopulate\AutoPopulate.exe (+ thư mục .playwright điều khiển Chrome).
  Máy chạy cần cài sẵn Google Chrome.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\AutoPopulate\</PublishDir>
  </PropertyGroup>
</Project>
